{% extends 'pages/_base.jinja' %}


{% block content %}

    <h1>the cosmedic clinic appointments</h1>

    <section id="opintments">
    
    {% for booking in bookings %}

{# what info i have to show of them #}
        <div class="opintment">
        
          <h2> {{ booking.name }}</h2> 

         <h3>time: </h3> <p>{{ booking.time }}</p>

          <h3>phone: </h3> <p>{{ booking.phone }}</p>

          <h3>treatment: </h3> <p>{{ booking.treatment }}</p>

          <a href="/booking/{{ booking.b_id }}/delete">delete</a>

        </div>
    {% else %}
    {# if there is no opintments #}

    <p> no opintmets</p>

    {% endfor %}

    
    </section>

   
{% endblock %}

