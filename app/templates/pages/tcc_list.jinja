{% extends 'pages/_base.jinja' %}


{% block content %}

    <h2>the cosmedic clinic opintmets</h2>

    <section id="bookings">
    
    {% for booking in bookings %}


        <div class="opintment">
        
          <h3> {{ booking.name }} </h3>
          <p>time: <strong> {{ booking.time }}</strong></p>
          <p>phone: <strong> {{ booking.phone }}</strong></p>
          <p>treatment: <strong> {{ booking.treatment }}</strong></p>
        </div>
    {% else %}

    <p> no opintmets</p>

    {% endfor %}

    
    </section>

   
{% endblock %}

