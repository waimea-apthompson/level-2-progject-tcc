{% extends 'pages/_base.jinja' %}


{% block content %}

    <h2>the cosmedic clinic opintmets</h2>

    <section id="bookings">
    
    {% for booking in bookings %}


        <div class="opintment">
        
          <h3>{{ people.name }}</h3>
          <p>time: <strong> {{ bookings.time }}</strong></p>
          <p>date: <strong> {{ bookings.date }}</strong></p>
          <p>phone: <strong> {{ people.phone }}</strong></p>
          <p>treatment: <strong> {{ bookings.treatment }}</strong></p>
        </div>
    {% else %}

    <p> no opintmets</p>

    {% endfor %}

    
    </section>

   
{% endblock %}

