{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}
 <h1 class="welcome">Welcome!</h1>

  <section>
  {# people who have come back #}
    <h2>Have we seen you before?</h2>

    <form method="post" action="/cust/current">
    
      <label>
        name
{# make sure its them #}
        <select name = "person_id">
          {% for person in people %}
            <option value="{{ person.id }}">
              {{ person.name }}
            </option>
          {% endfor %}
        </select>

      </label>

      <button>Next</button>
    </form>
  </section>

  <section>
  {# new people  #}
    <h2>New customer?</h2>

    <form method="post" action="/cust/new">
{# what i need them to put in for info #}
      <label>
        name
        <input type="text" name="name" required>
      </label>
    
      <label>
        phone
        <input type="text" name="phone" required>
      </label>

      <button>Next</button>
    </form>
  </section>
   
{% endblock %}

